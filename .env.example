# AVA Environment Configuration
# Copy to repository-root .env and fill in values.
# Loaded automatically by ./scripts/dev_backend.sh and by Vite (envDir).

# Application
AVA_APPLICATION=AVA
AVA_ENVIRONMENT=development

# Provider selection (configuration-driven; adapters land in later sprints)
# Agent selection: mock (offline default) or native (uses AVA_MODEL_PROVIDER)
AVA_AGENT_PROVIDER=mock
AVA_AGENT_RUNTIME=native
AVA_MODEL_PROVIDER=local
AVA_MODEL_NAME=local-model
# Stable, provider-neutral AVA model identity. Optional; blank derives
# "<model_provider>-<model_name>" for backward compatibility.
AVA_MODEL_ID=
# Server-owned deployment placement for the configured model binding.
# One of: local | company_hosted | external. Never inferred from provider or URL.
# Optional; blank defaults to "local" for the local bootstrap path.
AVA_MODEL_HOSTING_MODE=local
AVA_LOCAL_MODEL_BASE_URL=http://localhost:11434/v1

# API transport (localhost-only by default; set AVA_HOST=0.0.0.0 for LAN access)
AVA_HOST=127.0.0.1
AVA_PORT=8000
AVA_DEBUG=true
AVA_LOG_LEVEL=info

# Persistence (Phase 4). Default "memory" keeps the in-memory stores;
# "relational" activates the durable SQLite adapters for every Phase 4 domain
# (run, run-event, conversation, message, document, document revision,
# attachment) over one shared database.
AVA_PERSISTENCE=relational
# Database location used when AVA_PERSISTENCE=relational.
AVA_PERSISTENCE_DATABASE_URL=ava.sqlite3

# Attachment content storage (Step 4.14.D). Independent of AVA_PERSISTENCE.
# "memory" (default) keeps the in-memory content store; "local" selects the
# local-filesystem adapter.
AVA_ATTACHMENT_STORAGE=local
# Filesystem root for attachment content. REQUIRED when
# AVA_ATTACHMENT_STORAGE=local; ignored in memory mode. The root is created if
# it does not yet exist.
AVA_ATTACHMENT_STORAGE_ROOT=.ava/attachments

# Frontend
VITE_API_BASE_URL=http://localhost:8000
