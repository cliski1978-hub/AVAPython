# AVA Environment Configuration
# Copy to repository-root .env and fill in values.
# Loaded automatically by ./scripts/dev_backend.sh and by Vite (envDir).

# Application
AVA_APPLICATION=AVA
AVA_ENVIRONMENT=development

# Provider selection (configuration-driven; adapters land in later sprints)
AVA_AGENT_PROVIDER=mock
AVA_MODEL_PROVIDER=local

# API transport (localhost-only by default; set AVA_HOST=0.0.0.0 for LAN access)
AVA_HOST=127.0.0.1
AVA_PORT=8000
AVA_DEBUG=true
AVA_LOG_LEVEL=info

# Frontend
VITE_API_BASE_URL=http://localhost:8000