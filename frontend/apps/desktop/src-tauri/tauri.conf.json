{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AVA Desktop",
  "version": "0.1.0",
  "identifier": "com.ava.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AVA Desktop",
        "width": 1100,
        "height": 750
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"],
    "targets": "all"
  }
}
